{
  "name": "RpConversion",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Player ID who performed the conversion"
    },
    "player_username": {
      "type": "string",
      "description": "Username of the player"
    },
    "rp_spent": {
      "type": "number",
      "description": "Amount of RP spent in the conversion"
    },
    "rpx_earned": {
      "type": "number",
      "description": "Amount of RPx earned after halving rate applied"
    },
    "halving_rate": {
      "type": "number",
      "description": "The halving rate applied at time of conversion"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the conversion"
    }
  },
  "required": [
    "player_id",
    "player_username",
    "rp_spent",
    "rpx_earned",
    "halving_rate"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "superuser"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "superuser"
      }
    },
    "delete": {
      "user_condition": {
        "role": "superuser"
      }
    }
  }
}