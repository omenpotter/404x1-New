{
  "name": "RpSpend",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Player ID who spent the RP"
    },
    "player_username": {
      "type": "string",
      "description": "Username of the player"
    },
    "action": {
      "type": "string",
      "description": "Sink action performed (highlight_message, pin_message, username_color, profile_frame)"
    },
    "cost": {
      "type": "number",
      "description": "Total RP cost of the action"
    },
    "burned_rp": {
      "type": "number",
      "description": "RP permanently burned (25% of cost)"
    },
    "duration_weeks": {
      "type": "number",
      "description": "Duration in weeks for timed actions"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the purchased effect expires"
    }
  },
  "required": [
    "player_id",
    "player_username",
    "action",
    "cost",
    "burned_rp"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "superuser"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "superuser"
      }
    },
    "delete": {
      "user_condition": {
        "role": "superuser"
      }
    }
  }
}